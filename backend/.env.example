# ==============================================================
# Everyticket Subscription Platform - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
#
# IMPORTANT - "redis" as a hostname below only resolves inside the Docker
# Compose network (docker-compose.yml names that service "redis"). If
# you're running the backend directly on your machine (pip install +
# uvicorn, not `docker compose up`), change "redis://redis:" to
# "redis://localhost:" below - otherwise you'll get a connection error at
# startup.
#
# DATABASE_URL below is DIFFERENT: this deployment's MySQL/MariaDB is NOT
# a container docker-compose.yml manages - it's already installed
# directly on the host. "host.docker.internal" is Docker's own hostname
# for "the machine the container engine runs on" (docker-compose.yml's
# `extra_hosts:` entries make this resolve on Linux too, not just Docker
# Desktop). If you're running the backend directly on the host instead of
# via `docker compose up`, use "localhost" there instead - "localhost"
# inside a CONTAINER means the container itself, not the host, so it
# will NOT reach a host-installed database.
# ==============================================================

# --- General ---
ENVIRONMENT=development            # development | staging | production
APP_NAME=Everyticket Subscription Platform
APP_URL=http://localhost:8002
TIMEZONE=Asia/Kolkata
CURRENCY=INR

# --- Database (MySQL, already installed on the host - not a compose service) ---
# The DB user here must be GRANTed for a host pattern that covers the
# Docker bridge network, not just '<user>'@'localhost' - a fresh
# container's connection arrives from a bridge-network IP, which
# '@localhost'-only accounts (e.g. Debian/Ubuntu's package-maintenance
# "debian-sys-maint" account) will always reject. Create a dedicated app
# user instead, e.g.:
#   CREATE USER 'everyticket_app'@'%' IDENTIFIED BY 'a-strong-password';
#   GRANT ALL PRIVILEGES ON `plans-subscription`.* TO 'everyticket_app'@'%';
#   FLUSH PRIVILEGES;
# ('%' = any host; fine for a single-server deploy as long as MySQL's
# port isn't exposed to the internet - check your cloud firewall/security
# group, not just this file. Restrict to the actual Docker bridge subnet,
# from `docker network inspect <project>_default`, for a tighter grant.)
# Also confirm bind-address in my.cnf/mariadb.conf.d isn't left at
# 127.0.0.1-only - that only accepts true loopback, not a container's IP.
DATABASE_URL=mysql+pymysql://everyticket_app:change-me@host.docker.internal:3306/plans-subscription?charset=utf8mb4

# --- Redis / Celery ---
# Same "localhost" vs "redis" note as the top of this file.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth / Security ---
JWT_SECRET=change-me-dev-only-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- SSO (Everyticket -> Subscription App) ---
SSO_SECRET=change-me-dev-only-sso-secret
SSO_TOKEN_TTL_SECONDS=120

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Test-mode safety switches (development/staging ONLY, backend-enforced) ---
ALLOW_OTP_BYPASS=true
ALLOW_ADMIN_MFA_BYPASS=true
TEST_MODE=true

# --- Email (SMTP) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_SENDER_NAME=Everyticket Subscriptions
EMAIL_SENDER_ADDRESS=no-reply@example.com
EMAIL_REPLY_TO=support@example.com

# --- Payment: default gateway ---
DEFAULT_PAYMENT_GATEWAY=mock       # mock | payu
PAYMENT_GATEWAY_MODE=test          # test | live

# --- PayU (fill in for real sandbox testing) ---
# 1. Set your PayU test merchant key/salt below (get these from your PayU
#    dashboard's test/sandbox credentials, NOT the live ones).
# 2. These two vars alone are not enough to actually route payments to
#    PayU - DEFAULT_PAYMENT_GATEWAY here is currently unused; the real
#    switch is the seeded EVERYTICKET application's default_gateway
#    column (defaults to "mock"). Flip it once your key/salt are set:
#      mysql -u subscription -p subscription -e "UPDATE applications SET default_gateway='payu' WHERE code='EVERYTICKET';"
#    (or back to 'mock' to go back to the simulate-payment buttons).
# 3. PAYU_BASE_URL is PayU's TEST endpoint - do not point this at
#    secure.payu.in (production) with test credentials, and never point
#    it at secure.payu.in at all until this app has had a real security
#    review (spec section 81) - V1 is sandbox-only by design.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_BASE_URL=https://test.payu.in
PAYU_SUCCESS_URL=http://localhost:8002/api/v1/payment/payu/callback/success
PAYU_FAILURE_URL=http://localhost:8002/api/v1/payment/payu/callback/failure

# --- Everyticket integration ---
EVERYTICKET_API_URL=http://localhost:9000/api
EVERYTICKET_API_KEY=change-me-everyticket-api-key
EVERYTICKET_WEBHOOK_URL=http://localhost:9000/webhooks/subscription
EVERYTICKET_WEBHOOK_SECRET=change-me-everyticket-webhook-secret

# --- Webhook delivery ---
WEBHOOK_RETRY_SCHEDULE_MINUTES=5,15,60,360,1440

# --- Frontend ---
# The React frontend (spec section 77) is a separate app/origin from
# this API, with its own Dockerfile/README - see ../frontend/README.md
# for how to run it (`npm run dev`, default http://localhost:5173). It's
# not part of this backend/docker-compose.yml.
# FRONTEND_URL is informational (used in links/emails, not enforced).
# CORS_ORIGINS is enforced - the browser origin the frontend is
# actually opened at MUST be in this list or the API rejects the
# request before it reaches app code (see app/main.py's CORSMiddleware).
# Both "localhost" and "127.0.0.1" are listed per port since browsers
# treat them as different origins even though they resolve the same.
FRONTEND_URL=http://localhost:5173

# --- Invoices (spec section 45) ---
# GST/tax rate + seller GSTIN are admin-editable at runtime (system_settings
# table, via PUT /api/v1/admin/invoices/tax-config) - this is only where
# generated invoice PDFs are cached on disk.
INVOICE_PDF_STORAGE_DIR=var/invoices
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
