# ==============================================================
# Compose-level configuration ONLY - variable substitution inside
# docker-compose.yml itself (e.g. `${VITE_API_BASE_URL:-...}` in the
# frontend service's build args). Copy to .env in this same directory
# (the repo root, next to docker-compose.yml).
#
# This is NOT where backend secrets/runtime config go - that's
# backend/.env (copied from backend/.env.example). Kept separate because
# VITE_API_BASE_URL has to be available as a Docker build ARG at image
# build time, not as a container runtime env var (see frontend/
# Dockerfile's comment for why) - mixing it into backend/.env, which IS
# read at container runtime, wouldn't work for this one.
#
# NEVER commit the real .env file.
# ==============================================================

# The BROWSER calls this URL directly, so it must be something the
# browser can actually reach - your public domain (once this is behind
# the host's nginx, e.g. https://plans.everyticket.in) or http://<server
# -ip>:8002 for a quick check before that's wired up. NEVER a Docker
# service name like "backend:8002" - the browser has no idea what that
# is (it's only resolvable to other containers on the compose network).
VITE_API_BASE_URL=http://localhost:8002
