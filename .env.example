# ==============================================================
# This file belongs to docker-compose.yml ITSELF, not to backend/ or
# frontend/ as apps - it's Docker Compose's own standard mechanism for
# variable substitution inside the compose YAML (build args, image
# tags, etc.), documented as "setting default environment variables"
# in Compose's own docs. Compose auto-loads a file literally named
# .env from the SAME DIRECTORY as docker-compose.yml (the repo root,
# since this file orchestrates both backend/ and frontend/ as
# siblings) - it does not and cannot read backend/.env or frontend/.env
# for this purpose, regardless of what's in them.
#
# This is a different mechanism from `env_file:` (what backend/.env
# does) - that loads variables into a CONTAINER's runtime environment;
# this loads variables into the docker-compose.yml FILE, before any
# container exists. VITE_API_BASE_URL has to be here specifically
# because it's a Docker build ARG (baked into the frontend's static
# bundle at `npm run build` time) - a runtime env var on the container,
# which is all backend/.env can ever provide, would have no effect on
# it at all (see frontend/Dockerfile's own comment).
#
# NEVER commit the real .env file.
# ==============================================================

# The BROWSER calls this URL directly, so it must be something the
# browser can actually reach - your public domain (once this is behind
# the host's nginx, e.g. https://plans.everyticket.in) or http://<server
# -ip>:8002 for a quick check before that's wired up. NEVER a Docker
# service name like "backend:8002" - the browser has no idea what that
# is (it's only resolvable to other containers on the compose network).
VITE_API_BASE_URL=http://localhost:8002
