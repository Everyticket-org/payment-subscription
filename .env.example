# ==============================================================
# Everyticket Subscription Platform - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
#
# IMPORTANT - "postgres" and "redis" as hostnames below only resolve
# inside the Docker Compose network (docker-compose.yml names those
# services "postgres" and "redis"). If you're running the backend
# directly on your machine (pip install + uvicorn, not
# `docker compose up`), change every "@postgres:" to "@localhost:" and
# every "redis://redis:" to "redis://localhost:" below - otherwise
# you'll get "could not translate host name" errors from psycopg2/redis.
# ==============================================================

# --- General ---
ENVIRONMENT=development            # development | staging | production
APP_NAME=Everyticket Subscription Platform
APP_URL=http://localhost:8000
TIMEZONE=Asia/Kolkata
CURRENCY=INR

# --- Database ---
# Use "localhost" instead of "postgres" here if running the backend
# directly rather than via docker compose - see note above.
DATABASE_URL=postgresql+psycopg2://subscription:subscription@postgres:5432/subscription
POSTGRES_USER=subscription
POSTGRES_PASSWORD=subscription
POSTGRES_DB=subscription

# --- Redis / Celery ---
# Same "localhost" vs "postgres"/"redis" note as DATABASE_URL above.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth / Security ---
JWT_SECRET=change-me-dev-only-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- SSO (Everyticket -> Subscription App) ---
SSO_SECRET=change-me-dev-only-sso-secret
SSO_TOKEN_TTL_SECONDS=120

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Test-mode safety switches (development/staging ONLY, backend-enforced) ---
ALLOW_OTP_BYPASS=true
ALLOW_ADMIN_MFA_BYPASS=true
TEST_MODE=true

# --- Email (SMTP) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_SENDER_NAME=Everyticket Subscriptions
EMAIL_SENDER_ADDRESS=no-reply@example.com
EMAIL_REPLY_TO=support@example.com

# --- Payment: default gateway ---
DEFAULT_PAYMENT_GATEWAY=mock       # mock | payu
PAYMENT_GATEWAY_MODE=test          # test | live

# --- PayU (fill in for real sandbox testing) ---
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_BASE_URL=https://test.payu.in
PAYU_SUCCESS_URL=http://localhost:8000/api/v1/payment/payu/callback/success
PAYU_FAILURE_URL=http://localhost:8000/api/v1/payment/payu/callback/failure

# --- Everyticket integration ---
EVERYTICKET_API_URL=http://localhost:9000/api
EVERYTICKET_API_KEY=change-me-everyticket-api-key
EVERYTICKET_WEBHOOK_URL=http://localhost:9000/webhooks/subscription
EVERYTICKET_WEBHOOK_SECRET=change-me-everyticket-webhook-secret

# --- Webhook delivery ---
WEBHOOK_RETRY_SCHEDULE_MINUTES=5,15,60,360,1440

# --- Frontend ---
# The React frontend (spec section 77) is a separate app/origin from
# this API - see frontend/README.md for how to run it. Two common
# ways to run it locally, each with a different default port:
#   - `npm run dev` (Vite dev server, the normal way): http://localhost:5173
#   - `docker compose up` (frontend service in docker-compose.yml):
#     http://localhost:3000
# FRONTEND_URL is informational (used in links/emails, not enforced).
# CORS_ORIGINS is enforced - the browser origin the frontend is
# actually opened at MUST be in this list or the API rejects the
# request before it reaches app code (see app/main.py's CORSMiddleware).
# Both "localhost" and "127.0.0.1" are listed per port since browsers
# treat them as different origins even though they resolve the same.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
