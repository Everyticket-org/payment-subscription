# ==============================================================
# Everyticket Subscription Platform - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==============================================================

# --- General ---
ENVIRONMENT=development            # development | staging | production
APP_NAME=Everyticket Subscription Platform
APP_URL=http://localhost:8000
TIMEZONE=Asia/Kolkata
CURRENCY=INR

# --- Database (MySQL, since the 2026-09-13 "change database to mysql" switch) ---
DATABASE_URL=mysql+pymysql://root:@localhost:3306/subscriptions?charset=utf8mb4
# The MYSQL_* values below aren't read by the app directly (DATABASE_URL above
# is the only thing app/core/config.py uses) - kept here only as a readable
# record of what's plugged into DATABASE_URL, matching your local MySQL setup.
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=subscriptions

# --- Admin bootstrap (optional) ---
# Set BOTH of these to create/keep a specific admin login across a fresh
# database reset, instead of the dev-default admin@example.com. Neither
# value is ever printed or logged by the app. Fill these in yourself -
# left blank here since only you should choose your own admin password.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth / Security ---
JWT_SECRET=ABCDEFGHIJKLMNOP
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- SSO (Everyticket -> Subscription App) ---
SSO_SECRET=EVERYTICKET
SSO_TOKEN_TTL_SECONDS=120

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Test-mode safety switches (development/staging ONLY, backend-enforced) ---
ALLOW_OTP_BYPASS=true
ALLOW_ADMIN_MFA_BYPASS=true
TEST_MODE=true

# --- Email (SMTP) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_SENDER_NAME=Everyticket Subscriptions
EMAIL_SENDER_ADDRESS=no-reply@example.com
EMAIL_REPLY_TO=support@example.com

# --- Payment: default gateway ---
DEFAULT_PAYMENT_GATEWAY=mock       # mock | payu
PAYMENT_GATEWAY_MODE=test          # test | live

# --- PayU (fill in for real sandbox testing) ---
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_BASE_URL=https://test.payu.in
PAYU_SUCCESS_URL=http://localhost:8000/api/v1/payment/payu/callback/success
PAYU_FAILURE_URL=http://localhost:8000/api/v1/payment/payu/callback/failure

# --- Everyticket integration ---
EVERYTICKET_API_URL=http://localhost:9000/api
EVERYTICKET_API_KEY=change-me-everyticket-api-key
EVERYTICKET_WEBHOOK_URL=http://localhost:9000/webhooks/subscription
EVERYTICKET_WEBHOOK_SECRET=change-me-everyticket-webhook-secret

# --- Webhook delivery ---
WEBHOOK_RETRY_SCHEDULE_MINUTES=5,15,60,360,1440

# --- Frontend ---
FRONTEND_URL=http://localhost:4200
